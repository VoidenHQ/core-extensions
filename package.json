{
  "name": "@voiden/core-extensions",
  "version": "0.1.3",
  "description": "Core extensions bundled with Voiden",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./registry.js": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./src/*": "./src/*",
    "./main": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js",
      "default": "./dist/main.js"
    },
    "./markdown": {
      "types": "./dist/markdown/index.d.ts",
      "import": "./dist/markdown/index.js",
      "default": "./dist/markdown/index.js"
    },
    "./md-preview/*": {
      "types": "./dist/md-preview/*.d.ts",
      "import": "./dist/md-preview/*.js",
      "default": "./dist/md-preview/*.js"
    },
    "./hello-world/*": {
      "types": "./dist/hello-world/*.d.ts",
      "import": "./dist/hello-world/*.js",
      "default": "./dist/hello-world/*.js"
    },
    "./voiden-rest-api/help": {
      "types": "./dist/voiden-rest-api/help/index.d.ts",
      "import": "./dist/voiden-rest-api/help/index.js",
      "default": "./dist/voiden-rest-api/help/index.js"
    },
    "./simple-assertions/help": {
      "types": "./dist/simple-assertions/help/index.d.ts",
      "import": "./dist/simple-assertions/help/index.js",
      "default": "./dist/simple-assertions/help/index.js"
    },
    "./voiden-rest-api/runner": {
      "types": "./dist/voiden-rest-api/runner.d.ts",
      "import": "./dist/voiden-rest-api/runner.js",
      "default": "./dist/voiden-rest-api/runner.js"
    },
    "./voiden-graphql/runner": {
      "types": "./dist/voiden-graphql/runner.d.ts",
      "import": "./dist/voiden-graphql/runner.js",
      "default": "./dist/voiden-graphql/runner.js"
    },
    "./voiden-sockets/runner": {
      "types": "./dist/voiden-sockets/runner.d.ts",
      "import": "./dist/voiden-sockets/runner.js",
      "default": "./dist/voiden-sockets/runner.js"
    },
    "./voiden-scripting/runner": {
      "types": "./dist/voiden-scripting/runner.d.ts",
      "import": "./dist/voiden-scripting/runner.js",
      "default": "./dist/voiden-scripting/runner.js"
    },
    "./simple-assertions/runner": {
      "types": "./dist/simple-assertions/runner.d.ts",
      "import": "./dist/simple-assertions/runner.js",
      "default": "./dist/simple-assertions/runner.js"
    },
    "./voiden-faker/runner": {
      "types": "./dist/voiden-faker/runner.d.ts",
      "import": "./dist/voiden-faker/runner.js",
      "default": "./dist/voiden-faker/runner.js"
    },
    "./voiden-advanced-auth/runner": {
      "types": "./dist/voiden-advanced-auth/runner.d.ts",
      "import": "./dist/voiden-advanced-auth/runner.js",
      "default": "./dist/voiden-advanced-auth/runner.js"
    }
  },
  "scripts": {
    "generate-registry": "node scripts/generate-registry.js",
    "prebuild": "yarn generate-registry",
    "sass": "sass src:dist",
    "build": "tsc && yarn run sass",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "build:bundles": "node scripts/build-bundles.mjs",
    "generate-release-manifest": "node scripts/generate-release-manifest.mjs",
    "release:bundles": "yarn build:bundles && yarn generate-release-manifest"
  },
  "dependencies": {
    "@faker-js/faker": "^9.0.3",
    "@voiden/sdk": "1.0.10-beta.0",
    "js-yaml": "^4.1.0",
    "selfsigned": "^5.5.0",
    "shell-quote": "^1.8.1",
    "xlsx-js-style": "^1.2.0"
  },
  "peerDependencies": {
    "@tiptap/core": "^2.8.0",
    "@tiptap/pm": "^2.8.0",
    "@tiptap/react": "^2.8.0",
    "@tiptap/suggestion": "^2.8.0",
    "lucide-react": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "*",
    "remark-gfm": "*",
    "tippy.js": "*",
    "zustand": "*"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "*",
    "@codemirror/state": "*",
    "@codemirror/view": "*",
    "@tanstack/react-query": "*",
    "@tiptap/core": "^2.8.0",
    "@tiptap/pm": "^2.8.0",
    "@tiptap/react": "^2.8.0",
    "@tiptap/suggestion": "^2.8.0",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@types/selfsigned": "^2.1.0",
    "@types/shell-quote": "^1.7.1",
    "lucide-react": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "*",
    "remark-gfm": "*",
    "sass": "^1.89.2",
    "tippy.js": "*",
    "typescript": "^5.0.0",
    "undici": "^7.22.0",
    "vite": "^5.0.0",
    "zustand": "*"
  },
  "keywords": [
    "voiden",
    "extensions",
    "core"
  ],
  "author": "Voiden",
  "license": "MIT"
}
